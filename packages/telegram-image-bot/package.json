{
  "name": "@omniroute/telegram-image-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that batch-processes photos: smart crop, uniform sizing, ZIP delivery",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "try": "node scripts/try-local.js",
    "samples": "node scripts/make-samples.js",
    "selftest": "node scripts/selftest.js",
    "dryrun": "node scripts/bot-dryrun.js",
    "test": "node scripts/selftest.js",
    "format": "prettier --config ../../prettier.config.mjs --write \"src/**/*.js\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "sharp": "^0.35.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
