# ── Required ─────────────────────────────────────────────────────────────────
# Token from @BotFather on Telegram.
BOT_TOKEN=

# ── Output (defaults match the spec: 2000x2000 JPEG q95) ─────────────────────
OUTPUT_WIDTH=2000
OUTPUT_HEIGHT=2000
JPEG_QUALITY=95
# jpeg | png | webp
OUTPUT_FORMAT=jpeg
# Empty space kept around the subject, as a percentage of the canvas.
OUTPUT_MARGIN_PERCENT=3
# "auto" reuses the detected background colour; or set any CSS colour (e.g. #ffffff).
OUTPUT_BACKGROUND=auto

# ── Smart detection (heuristic layer — always on, needs no key) ───────────────
# Longest side used for analysis. Larger is slower, not more accurate.
DETECT_ANALYSIS_SIZE=480
# How far from the background colour (0-255) a pixel must be to count as content.
DETECT_TOLERANCE=18
# Blobs smaller than this share of the subject are candidates for removal.
DETECT_NOISE_AREA_RATIO=0.06
# A small blob farther than this share of the canvas from the subject is dropped
# (captions, page numbers, watermarks live there). Raise it to trim more aggressively.
DETECT_DETACH_GAP_RATIO=0.02
# Above this content coverage there is no border worth trimming.
DETECT_FULL_FRAME_RATIO=0.97
# Safety padding added back around the subject.
DETECT_SAFETY_PAD_RATIO=0.012

# ── Optional AI layer ────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to stay on the heuristic detector (fast, offline, free).
# Fill it in and the bot asks a vision model to refine each crop; the heuristic
# subject box remains the floor, so the AI can tighten a crop but never cut the subject.
AI_API_KEY=
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, or a local OmniRoute instance.
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_IMAGE_SIZE=768
# Set to false to keep the key but disable the layer.
# AI_DETECTION_ENABLED=true

# ── Batch behaviour ──────────────────────────────────────────────────────────
PROCESS_CONCURRENCY=3
MAX_IMAGES_PER_BATCH=300
# Telegram caps bot uploads at 50 MB; larger batches are split into ZIP parts.
MAX_ZIP_BYTES=47185920
COLLECT_DEBOUNCE_MS=900
PROGRESS_INTERVAL_MS=1500
SESSION_TTL_MS=3600000

# ── Misc ─────────────────────────────────────────────────────────────────────
# Temp directory for downloads and ZIPs. Defaults to the OS temp dir.
# WORK_DIR=
# error | warn | info | debug
LOG_LEVEL=info
